---
// Renders an Iconify icon as inline SVG at build time (no runtime JS).
// Usage: <Icon name="lucide:mail" /> or <Icon name="brands:github" />
import { getIconData, iconToSVG, iconToHTML, replaceIDs } from '@iconify/utils';
import lucide from '@iconify-json/lucide/icons.json';
import brands from '@iconify-json/fa6-brands/icons.json';
import simple from '@iconify-json/simple-icons/icons.json';

const sets = { lucide, brands, simple } as const;

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, size = '1em', class: className, label } = Astro.props;
const [prefix, iconName] = name.split(':') as [keyof typeof sets, string];
const data = sets[prefix] && getIconData(sets[prefix] as any, iconName);
if (!data) throw new Error(`Unknown icon: ${name}`);

const { attributes, body } = iconToSVG(data, { height: size });
const svg = iconToHTML(replaceIDs(body), {
  ...attributes,
  class: ['icon', className].filter(Boolean).join(' '),
  ...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }),
});
---

<Fragment set:html={svg} />
