---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Logo from '@/components/ui/Logo.astro';
import ExtLink from '@/components/ui/ExtLink.astro';
import { achievements } from '@/data/achievements';
import { logos } from '@/data/logos';

const [featured, ...rest] = achievements;
---

<section id="achievements" class="section container">
  <SectionHeading title="Achievements" />

  <article class="card featured">
    <div class="art">
      {featured.logo && <Image src={logos[featured.logo]} alt="" width={320} />}
    </div>
    <div class="body">
      <h3>{featured.title}</h3>
      <p>{featured.text}</p>
      {
        featured.links.length > 0 && (
          <div class="link-row">
            {featured.links.map((l) => (
              <ExtLink {...l} />
            ))}
          </div>
        )
      }
    </div>
  </article>

  <div class="grid-3">
    {
      rest.map((a) => (
        <article class="card item">
          <div class="head">
            <Logo logo={a.logo} icon={a.icon} alt="" />
            <div>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
          </div>
          {a.links.length > 0 && (
            <div class="link-row">
              {a.links.map((l) => (
                <ExtLink {...l} />
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .featured {
    display: grid;
    gap: 24px;
    margin-top: 32px;
    padding: clamp(20px, 3vw, 28px);
  }

  .art {
    display: grid;
    place-items: center;
    padding: 24px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--border);
  }

  .art :global(img) {
    width: 100%;
    max-width: 180px;
    height: auto;
  }

  .featured h3 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.04em;
  }

  .featured p {
    margin-top: 12px;
    color: var(--muted);
    line-height: 1.7;
  }

  .featured .link-row {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .grid-3 {
    margin-top: 20px;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px;
  }

  .head {
    display: flex;
    gap: 16px;
  }

  .item h3 {
    font-size: 1.08rem;
    letter-spacing: -0.02em;
  }

  .item p {
    margin-top: 8px;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .item .link-row {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 760px) {
    .featured {
      grid-template-columns: 240px minmax(0, 1fr);
      align-items: center;
      gap: 32px;
    }
  }
</style>
