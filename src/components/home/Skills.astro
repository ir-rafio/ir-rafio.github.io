---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { skillGroups } from '@/data/skills';
---

<section id="skills" class="section container">
  <SectionHeading title="Technical Skills" />
  <div class="grid-3">
    {
      skillGroups.map((g) => (
        <article class="card group">
          <div class="head">
            <span class="logo-box icon-only">
              <Icon name={g.icon} size={22} />
            </span>
            <h3>{g.title}</h3>
          </div>
          <ul>
            {g.skills.map((s) => (
              <li>
                {s.icon ? <Icon name={s.icon} /> : <span class="dot" />}
                {s.name}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .group {
    padding: 24px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .head .logo-box {
    width: 48px;
    height: 48px;
  }

  h3 {
    font-size: 1.08rem;
    letter-spacing: -0.02em;
  }

  .head p {
    margin-top: 4px;
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.5;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    border-radius: 10px;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--text-soft);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  li :global(.icon) {
    color: var(--muted);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-bright);
  }
</style>
