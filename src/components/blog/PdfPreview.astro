---
// Shows a PDF: an embedded viewer on wide screens, page images on phones
// (mobile browsers can't render PDFs inline), plus open/download buttons.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  file: string;
  title: string;
  pages: ImageMetadata[];
}

const { file, title, pages } = Astro.props;
---

<figure class="pdf">
  <iframe class="viewer" src={`${file}#view=FitH`} title={title} loading="lazy"></iframe>
  <div class="pages">
    {pages.map((p, i) => <Image src={p} alt={`${title}, page ${i + 1}`} width={900} loading="lazy" />)}
  </div>
  <figcaption>
    <a class="btn" href={file} target="_blank" rel="noopener"><Icon name="lucide:external-link" /> Open PDF</a>
    <a class="btn" href={file} download><Icon name="lucide:download" /> Download</a>
  </figcaption>
</figure>

<style>
  .pdf {
    margin-inline: 0;
  }

  .viewer {
    display: none;
    width: 100%;
    height: 900px;
    background: var(--surface-2);
  }

  .pages {
    display: grid;
    gap: 14px;
  }

  .pages :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }

  @media (min-width: 900px) and (hover: hover) {
    .viewer {
      display: block;
    }
    .pages {
      display: none;
    }
  }
</style>
