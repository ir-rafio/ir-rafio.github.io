---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { courseGroups, inspirations, teachingIntro } from '@/data/teaching';
import { rich } from '@/lib/text';

---

<BaseLayout title="Teaching" description="How Irfanur Rahman Rafio became a teacher, and the courses he has taught at IUT and UIU.">
  <div class="container page">
    <SectionHeading as="h1" title="Teaching" />

    <div class="intro prose">
      {teachingIntro.map((p) => <p>{p}</p>)}
      <p>
        Some of the people who inspired me to pursue this profession are{' '}
        {
          inspirations.map((t, i) => (
            <>
              <a href={t.href} target="_blank" rel="noopener">
                {t.name}
              </a>
              {t.fictional && '*'}
              {i < inspirations.length - 2 ? ', ' : i === inspirations.length - 2 ? ' and ' : '.'}
            </>
          ))
        }
      </p>
      <p class="footnote">* Fictional characters.</p>
    </div>


    <section class="block">
      <h2>Courses I have taught</h2>
      {
        courseGroups.map((g) => (
          <div class="group">
            <h3 class="group-title">
              <Icon name="lucide:school" /> {g.institution}
            </h3>
            {g.note && <p class="group-note">{g.note}</p>}
            <div class="courses">
              {g.courses.map((c) => (
                <article class="card course">
                  <header>
                    <div>
                      {c.code && <span class="code">{c.code}</span>}
                      <h4>{c.title}</h4>
                    </div>
                    <span class="chip">{c.kind}</span>
                  </header>
                  <div class="chips terms">
                    {c.terms.map((t) => (
                      <span class="chip accent">{t}</span>
                    ))}
                  </div>
                  <ul class="bullets">
                    {c.points.map((p) => (
                      <li set:html={rich(p)} />
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </section>

  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .intro {
    margin-top: 28px;
    max-width: 72ch;
    font-size: 1.1rem;
  }

  .intro .footnote {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .intro p:first-child {
    font-size: 1.3rem;
    color: var(--text);
    font-weight: 500;
  }

  .block {
    margin-top: clamp(48px, 7vw, 80px);
  }

  .block > h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    letter-spacing: -0.04em;
  }


  .group {
    margin-top: 32px;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.25rem;
  }

  .group-title :global(.icon) {
    color: var(--accent);
  }

  .group-note {
    margin-top: 8px;
    max-width: 75ch;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .courses {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }

  @media (min-width: 900px) {
    .courses {
      grid-template-columns: 1fr 1fr;
    }
  }

  .course {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px 24px;
    box-shadow: var(--shadow-sm);
  }

  .course header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .code {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  h4 {
    margin-top: 2px;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .bullets {
    font-size: 0.92rem;
  }

  .course .link-row {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
</style>
