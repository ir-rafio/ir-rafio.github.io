---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import ExtLink from '@/components/ui/ExtLink.astro';
import { authoredCount, codeforces, judged, participations, problemTopics } from '@/data/contests';
import { gallery } from '@/data/gallery';

const topics = problemTopics();
const maxTopic = topics[0]?.count ?? 1;
const testedCount = judged.reduce((n, c) => n + c.tested.length, 0);
---

<BaseLayout
  title="Programming Contests"
  description="Contests Irfanur Rahman Rafio has competed in, the problems he has set for national contests in Bangladesh, and photos from them."
>
  <div class="container page">
    <SectionHeading
      as="h1"
      title="Programming Contests"
      intro="I competed for IUT until 2025. These days I mostly sit on the other side, setting and testing problems for national contests."
    />
    <nav class="jump" aria-label="On this page">
      <a href="#participation"><Icon name="lucide:swords" /> As a contestant</a>
      <a href="#problem-setting"><Icon name="lucide:gavel" /> Problem setting</a>
      <a href="#gallery"><Icon name="lucide:images" /> Gallery</a>
    </nav>

    <!-- Participation -->
    <section id="participation" class="block">
      <h2>As a contestant</h2>

      <div class="stats">
        <a class="card stat cf" href={codeforces.url} target="_blank" rel="noopener">
          <Logo logo="codeforces" alt="Codeforces logo" size={44} />
          <div>
            <span class="eyebrow">Codeforces</span>
            <strong class="expert">{codeforces.rank}</strong>
            <span>@{codeforces.handle}</span>
          </div>
        </a>
        <div class="card stat">
          <strong>{codeforces.maxRating}</strong>
          <span>max rating</span>
        </div>
        <div class="card stat">
          <strong>{codeforces.contests}</strong>
          <span>rated contests</span>
        </div>
        <div class="card stat">
          <strong>1200+</strong>
          <span>problems solved across judges</span>
        </div>
      </div>

      <ol class="contests">
        {
          participations.map((p) => (
            <li class="card contest">
              <div class="c-main">
                <Logo logo={p.logo} icon="lucide:trophy" alt="" size={46} />
                <div>
                  <h3>{p.name}</h3>
                  <div class="meta">
                    <span>
                      <Icon name="lucide:calendar" /> {p.date}
                    </span>
                    {p.venue && (
                      <span>
                        <Icon name="lucide:map-pin" /> {p.venue}
                      </span>
                    )}
                    {p.team && (
                      <span>
                        <Icon name="lucide:users" /> {p.team}
                        {p.teammates && ` (with ${p.teammates})`}
                      </span>
                    )}
                  </div>
                  {p.note && <p class="c-note">{p.note}</p>}
                  {(p.highlights.length > 0 || p.solved) && (
                    <div class="chips">
                      {p.solved && <span class="chip">{p.solved} solved</span>}
                      {p.highlights.map((h) => (
                        <span class="chip accent">{h}</span>
                      ))}
                    </div>
                  )}
                  {p.links.length > 0 && (
                    <div class="link-row">
                      {p.links.map((l) => (
                        <ExtLink {...l} />
                      ))}
                    </div>
                  )}
                </div>
              </div>
              <div class="rank">
                <strong>{p.rank}</strong>
                {p.field && <span>of {p.field}</span>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Problem setting -->
    <section id="problem-setting" class="block">
      <h2>Problem setting</h2>
      <p class="lead">
        I write and test problems for contests run by the Bangladesh Association of Problem Setters (BAPS) and the
        Bangladesh Competitive Programming Society (BCS), and I coordinate contests at IUT. My favorite problems are pure
        ad-hoc ones that reward out-of-the-box thinking, followed by math problems.
      </p>

      <div class="stats three">
        <div class="card stat">
          <strong>{judged.length}</strong>
          <span>contests</span>
        </div>
        <div class="card stat">
          <strong>{authoredCount}</strong>
          <span>problems written</span>
        </div>
        <div class="card stat">
          <strong>{testedCount}+</strong>
          <span>problems tested or developed</span>
        </div>
      </div>

      <div class="card topics">
        <h3>What my problems are about</h3>
        <ul>
          {
            topics.map((t) => (
              <li>
                <span class="t-name">{t.topic}</span>
                <span class="bar">
                  <span style={`width:${(t.count / maxTopic) * 100}%`} />
                </span>
                <span class="t-count">{t.count}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="setter-list">
        {
          judged.map((c) => (
            <article class="card setter">
              <header>
                <Logo logo={c.logo} icon="lucide:code-xml" alt="" size={46} />
                <div>
                  <h3>{c.name}</h3>
                  <div class="meta">
                    <span>
                      <Icon name="lucide:calendar" /> {c.date}
                    </span>
                    {c.host && (
                      <span>
                        <Icon name="lucide:map-pin" /> {c.host}
                      </span>
                    )}
                  </div>
                </div>
                <div class="roles">
                  {c.roles.map((r) => (
                    <span class="chip accent">{r}</span>
                  ))}
                </div>
              </header>
              {c.note && <p class="note">{c.note}</p>}
              {c.authored.length > 0 && (
                <div class="probs">
                  <span class="eyebrow">Problems I wrote</span>
                  <ul>
                    {c.authored.map((p) => (
                      <li>
                        <span class="pid">{p.id}</span>
                        <span class="ptitle">
                          {p.title}
                          {p.note && <small>{p.note}</small>}
                        </span>
                        <span class="ptags">
                          {p.topics.map((t) => (
                            <span class="chip">{t}</span>
                          ))}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {c.tested.length > 0 && (
                <p class="tested">
                  <span class="eyebrow">Tested</span> {c.tested.join(' · ')}
                </p>
              )}
              {c.links.length > 0 && (
                <div class="link-row">
                  {c.links.map((l) => (
                    <ExtLink {...l} />
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
      <p class="source">
        More editorials of the contests I worked on are collected at <a href="https://therealbcs.com/iupc" target="_blank" rel="noopener">therealbcs.com/iupc</a>.
      </p>
    </section>

    <!-- Gallery -->
    <section id="gallery" class="block">
      <h2>Gallery</h2>
      <div class="gallery">
        {
          gallery.map((g) => (
            <figure class="card">
              {g.type === 'image' ? (
                <a href={g.src.src} target="_blank" rel="noopener">
                  <Image src={g.src} alt={g.caption} width={640} loading="lazy" />
                </a>
              ) : (
                <video controls preload="none" poster={g.poster} playsinline>
                  <source src={g.src} type="video/mp4" />
                </video>
              )}
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-soft);
  }

  .jump a:hover {
    text-decoration: none;
    border-color: var(--accent-bright);
    color: var(--accent);
  }

  .block {
    margin-top: clamp(48px, 7vw, 80px);
  }

  .block > h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin-top: 12px;
    max-width: 75ch;
    color: var(--muted);
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 24px;
  }

  .stat {
    display: grid;
    align-content: center;
    padding: 18px 20px;
    box-shadow: var(--shadow-sm);
  }

  .stat strong {
    font-size: 1.8rem;
    letter-spacing: -0.03em;
  }

  .stat span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .cf {
    display: flex;
    align-items: center;
    gap: 14px;
    color: inherit;
  }

  .cf:hover {
    text-decoration: none;
    border-color: var(--accent-bright);
  }

  .cf div {
    display: grid;
  }

  .expert {
    color: #1f8acb;
    font-size: 1.4rem !important;
  }

  :global([data-theme='dark']) .expert {
    color: #5fb6ea;
  }

  .contests {
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .contest {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    box-shadow: var(--shadow-sm);
  }

  .c-main {
    display: flex;
    gap: 16px;
    min-width: 0;
  }

  .contest h3,
  .setter h3 {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .contest .meta,
  .setter .meta {
    margin-top: 6px;
  }

  .c-note {
    margin-top: 10px;
    max-width: 70ch;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .contest .chips {
    margin-top: 10px;
  }

  .contest .link-row {
    margin-top: 10px;
  }

  .rank {
    display: grid;
    justify-items: end;
    align-content: start;
    text-align: right;
    flex-shrink: 0;
    max-width: 40%;
  }

  .rank strong {
    font-size: 1.3rem;
    color: var(--accent);
    line-height: 1.2;
  }

  .rank span {
    font-size: 0.76rem;
    color: var(--muted);
  }

  .topics {
    margin-top: 20px;
    padding: 22px 24px;
    box-shadow: var(--shadow-sm);
  }

  .topics h3 {
    font-size: 1.05rem;
    margin-bottom: 14px;
  }

  .topics ul {
    display: grid;
    gap: 8px 32px;
    list-style: none;
  }

  .topics li {
    display: grid;
    grid-template-columns: 130px 1fr 24px;
    align-items: center;
    gap: 12px;
    font-size: 0.86rem;
  }

  .bar {
    height: 8px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent-bright), var(--accent));
  }

  .t-count {
    text-align: right;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .setter-list {
    display: grid;
    gap: 14px;
    margin-top: 20px;
  }

  .setter {
    padding: 20px 22px;
    box-shadow: var(--shadow-sm);
  }

  .setter header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px 16px;
  }

  .setter header > div:nth-child(2) {
    flex: 1;
    min-width: 200px;
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .note {
    margin-top: 12px;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  .probs {
    margin-top: 14px;
  }

  .probs ul {
    display: grid;
    gap: 8px;
    margin-top: 8px;
    list-style: none;
  }

  .probs li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .pid {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .ptitle {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .ptitle small {
    margin-left: 8px;
    font-weight: 400;
    color: var(--muted);
  }

  .ptags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-left: auto;
  }

  .ptags .chip {
    background: var(--surface);
    font-size: 0.7rem;
  }

  .tested {
    margin-top: 12px;
    font-size: 0.86rem;
    color: var(--text-soft);
  }

  .tested .eyebrow {
    margin-right: 6px;
  }

  .setter .link-row {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .source {
    margin-top: 18px;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .gallery {
    columns: 1;
    column-gap: 16px;
    margin-top: 24px;
  }

  .gallery figure {
    break-inside: avoid;
    margin: 0 0 16px;
    overflow: hidden;
  }

  .gallery :global(img),
  .gallery video {
    width: 100%;
    height: auto;
    background: #000;
  }

  .gallery figcaption {
    padding: 10px 14px 12px;
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .contest {
      flex-direction: column;
    }
    .rank {
      justify-items: start;
      text-align: left;
      max-width: none;
      padding-left: 62px;
    }
    .topics li {
      grid-template-columns: 110px 1fr 20px;
    }
  }

  @media (min-width: 640px) {
    .gallery {
      columns: 2;
    }
  }

  @media (min-width: 900px) {
    .stats {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
    .stats.three {
      grid-template-columns: repeat(3, 1fr);
    }
    .topics ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1060px) {
    .gallery {
      columns: 3;
    }
  }
</style>
